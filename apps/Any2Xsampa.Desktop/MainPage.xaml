<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Any2Xsampa_Desktop.MainPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="using:Any2Xsampa_Desktop.Services" Loaded="Page_Loaded">
 <Grid x:Name="PageLayout" Padding="16" RowSpacing="10" Background="{ThemeResource LayerFillColorDefaultBrush}" AllowDrop="True" DragOver="Audio_DragOver" Drop="Audio_Drop">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <VisualStateManager.VisualStateGroups>
   <VisualStateGroup>
    <VisualState x:Name="StackedPanels">
     <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers>
     <VisualState.Setters>
      <Setter Target="ReviewViewport.VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Target="PhoneList.Height" Value="160"/>
     </VisualState.Setters>
    </VisualState>
    <VisualState x:Name="SideBySidePanels">
     <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="800"/></VisualState.StateTriggers>
     <VisualState.Setters>
      <Setter Target="ReviewColumn.Width" Value="*"/>
      <Setter Target="SecondWorkspaceRow.Height" Value="0"/>
      <Setter Target="ReviewViewport.(Grid.Row)" Value="0"/>
      <Setter Target="ReviewViewport.(Grid.Column)" Value="1"/>
     </VisualState.Setters>
    </VisualState>
   </VisualStateGroup>
   <VisualStateGroup>
    <VisualState x:Name="CompactControls">
     <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers>
    </VisualState>
    <VisualState x:Name="WideControls">
     <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1200"/></VisualState.StateTriggers>
     <VisualState.Setters>
      <Setter Target="ModelBox.(Grid.ColumnSpan)" Value="1"/>
      <Setter Target="DeviceBox.(Grid.Row)" Value="0"/>
      <Setter Target="DeviceBox.(Grid.Column)" Value="1"/>
     </VisualState.Setters>
    </VisualState>
   </VisualStateGroup>
  </VisualStateManager.VisualStateGroups>

  <Grid ColumnSpacing="16">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Spacing="2" VerticalAlignment="Center">
    <TextBlock l:UiText.Text="DIVA" FontSize="28" FontWeight="SemiBold"/>
    <TextBlock l:UiText.Text="从音频到音素与 VSQX" FontSize="13" Opacity=".7" TextWrapping="Wrap"/>
   </StackPanel>
   <ComboBox x:Name="LanguageBox" Grid.Column="1" Width="210" l:UiText.Header="界面语言" l:UiText.AutomationName="界面语言" SelectionChanged="Language_Changed">
    <ComboBoxItem Tag="system" l:UiText.Content="跟随系统 / System"/>
    <ComboBoxItem Tag="en" l:UiText.Content="English"/>
    <ComboBoxItem Tag="zh" l:UiText.Content="中文"/>
   </ComboBox>
  </Grid>

  <!-- Task controls remain visible on every tab. -->
  <Border Grid.Row="1" Padding="12,8" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
   <Grid ColumnSpacing="16" RowSpacing="2">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Spacing="12">
     <TextBlock l:UiText.Text="识别范围" VerticalAlignment="Center"/>
     <RadioButton x:Name="WholeMode" l:UiText.Content="整首" GroupName="InferenceScope" IsChecked="True"/>
     <RadioButton x:Name="ClipMode" l:UiText.Content="当前片段" GroupName="InferenceScope"/>
    </StackPanel>
    <CheckBox x:Name="AutoVsqxBox" Grid.Row="1" l:UiText.Content="识别后自动生成 VSQX" IsChecked="True"/>
    <Grid x:Name="TaskActions" Grid.Column="1" Grid.RowSpan="2" ColumnSpacing="8" RowSpacing="6" VerticalAlignment="Center">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Button x:Name="RunButton" l:UiText.Content="开始识别" Click="Recognize_Click" Style="{StaticResource AccentButtonStyle}"
             l:UiText.AutomationName="开始真实音素识别" l:UiText.ToolTip="运行所选真实模型（Ctrl+Enter），不会改用回放数据">
      <Button.KeyboardAccelerators><KeyboardAccelerator Key="Enter" Modifiers="Control"/></Button.KeyboardAccelerators>
     </Button>
     <Button x:Name="CancelButton" Grid.Column="1" l:UiText.Content="取消" Click="Cancel_Click" IsEnabled="False"/>
     <ProgressRing x:Name="BusyRing" Grid.Column="2" Width="22" Height="22" IsActive="False" l:UiText.AutomationName="任务进行中"/>
     <ProgressBar x:Name="WholeProgress" Grid.Row="1" Grid.ColumnSpan="3" Maximum="100" Minimum="0" Height="4" Visibility="Collapsed" l:UiText.AutomationName="识别进度"/>
    </Grid>
   </Grid>
  </Border>

  <Pivot x:Name="WorkspaceTabs" Grid.Row="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" SelectionChanged="WorkspaceTabs_SelectionChanged">
   <PivotItem l:UiText.Header="工作区">
    <Grid x:Name="WorkspacePanels" RowSpacing="10" ColumnSpacing="12">
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="SecondWorkspaceRow" Height="*"/></Grid.RowDefinitions>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="ReviewColumn" Width="0"/></Grid.ColumnDefinitions>
     <ScrollViewer x:Name="WorkspaceScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch">
      <Border Padding="12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
       <StackPanel x:Name="AudioPanel" Spacing="10">
        <TextBlock l:UiText.Text="音频与片段" FontSize="18" FontWeight="SemiBold"/>
        <Grid ColumnSpacing="8">
         <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Button l:UiText.Content="打开 WAV" Click="Browse_Click" l:UiText.ToolTip="选择 WAV 文件，也可将文件拖入窗口"/>
         <TextBox x:Name="AudioPathBox" Grid.Column="1" IsReadOnly="True" l:UiText.Placeholder="选择 PCM WAV 文件" l:UiText.AutomationName="音频文件路径"/>
        </Grid>
        <Grid RowSpacing="8" ColumnSpacing="8">
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
         <ComboBox x:Name="ModelBox" Grid.ColumnSpan="2" l:UiText.Header="真实音素模型" HorizontalAlignment="Stretch" DisplayMemberPath="Label" SelectionChanged="Model_Changed"/>
         <ComboBox x:Name="DeviceBox" Grid.Row="1" l:UiText.Header="设备" SelectedIndex="0" HorizontalAlignment="Stretch">
          <ComboBoxItem l:UiText.Content="CUDA" Tag="cuda"/><ComboBoxItem l:UiText.Content="CPU（兼容模型）" Tag="cpu"/>
         </ComboBox>
        </Grid>
        <TextBlock x:Name="ModelStatus" l:UiText.Text="正在检查本地运行包……" TextWrapping="Wrap" FontSize="12" Opacity=".7"/>
        <Border Height="108" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6">
         <Canvas x:Name="Waveform" SizeChanged="Waveform_SizeChanged" PointerPressed="Waveform_PointerPressed" Background="Transparent" l:UiText.AutomationName="音频波形，点击选择片段起点"/>
        </Border>
        <Grid ColumnSpacing="8">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <NumberBox x:Name="StartBox" l:UiText.Header="起点（秒）" l:UiText.ToolTip="也可点击波形选择起点" Value="0" Minimum="0" SmallChange=".1" SpinButtonPlacementMode="Compact" ValueChanged="Range_Changed"/>
         <NumberBox x:Name="DurationBox" Grid.Column="1" l:UiText.Header="时长（0.1–20 秒）" Value="8" Minimum=".1" Maximum="20" SmallChange=".1" SpinButtonPlacementMode="Compact" ValueChanged="Range_Changed"/>
        </Grid>
        <MediaPlayerElement x:Name="Player" MinHeight="104" AreTransportControlsEnabled="True"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
         <Button l:UiText.Content="试听片段" Click="Play_Click"/><Button l:UiText.Content="停止" Click="Stop_Click"/><CheckBox x:Name="LoopBox" l:UiText.Content="循环"/>
        </StackPanel>
        <TextBlock x:Name="AudioStatus" l:UiText.Text="尚未选择音频" TextWrapping="Wrap" FontSize="12" Opacity=".7"/>
       </StackPanel>
      </Border>
     </ScrollViewer>

     <ScrollViewer x:Name="ReviewViewport" Grid.Row="1" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch">
     <Grid x:Name="ReviewPanel" RowSpacing="8" Padding="12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock l:UiText.Text="识别与审核" FontSize="18" FontWeight="SemiBold"/>
      <ScrollViewer Grid.Row="1" MaxHeight="66" VerticalScrollBarVisibility="Auto">
       <TextBlock x:Name="ResultStatus" l:UiText.Text="暂无结果。点击音素行试听附近；时间是发射线索，不是已确认的音素边界。" TextWrapping="Wrap" FontSize="12" Opacity=".7"/>
      </ScrollViewer>
      <Grid Grid.Row="2" ColumnSpacing="6" Padding="12,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="62"/><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <TextBlock l:UiText.Text="时间（秒）" TextWrapping="Wrap" FontSize="12"/>
       <TextBlock Grid.Column="1" l:UiText.Text="机器 IPA" TextWrapping="Wrap" FontSize="12"/>
       <TextBlock Grid.Column="2" l:UiText.Text="X-SAMPA" TextWrapping="Wrap" FontSize="12"/>
       <TextBlock Grid.Column="3" l:UiText.Text="IPA 草稿 · 自动保存" TextWrapping="Wrap" FontSize="12"/>
      </Grid>
      <ListView x:Name="PhoneList" Grid.Row="3" SelectionChanged="Phone_Selected" HorizontalContentAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Auto" l:UiText.AutomationName="音素识别结果与 IPA 草稿">
       <ListView.ItemTemplate><DataTemplate>
        <Grid ColumnSpacing="6" Padding="0,3">
         <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="62"/><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <TextBlock Text="{Binding TimeLabel}" VerticalAlignment="Center" FontSize="12"/>
         <TextBlock Grid.Column="1" Text="{Binding MachineIpa}" VerticalAlignment="Center" FontSize="20"/>
         <TextBlock Grid.Column="2" Text="{Binding XSampa}" VerticalAlignment="Center" TextWrapping="Wrap"/>
         <TextBox Grid.Column="3" Text="{Binding EditedIpa, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinWidth="70" l:UiText.AutomationName="人工 IPA 草稿"/>
        </Grid>
       </DataTemplate></ListView.ItemTemplate>
      </ListView>
      <StackPanel Grid.Row="4" Spacing="2">
       <CheckBox x:Name="UseDraftBox"><TextBlock l:UiText.Text="文本导出使用人工 IPA 修改" TextWrapping="Wrap"/></CheckBox>
       <TextBlock x:Name="DraftStatus" TextWrapping="Wrap" FontSize="12"/>
      </StackPanel>
      <Grid Grid.Row="5" ColumnSpacing="6" RowSpacing="6">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Button l:UiText.Content="导出 IPA" Click="ExportIpa_Click" HorizontalAlignment="Stretch"/>
       <Button Grid.Column="1" l:UiText.Content="导出 X-SAMPA" Click="ExportXSampa_Click" HorizontalAlignment="Stretch"/>
       <Button Grid.Row="1" Grid.ColumnSpan="2" l:UiText.Content="打开结果目录" Click="OpenOutput_Click" HorizontalAlignment="Stretch"/>
      </Grid>
     </Grid>
     </ScrollViewer>
    </Grid>
   </PivotItem>

   <PivotItem l:UiText.Header="音符与导出">
    <Grid ColumnSpacing="12">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
      <Border Padding="12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
       <StackPanel Spacing="10">
        <TextBlock l:UiText.Text="音符与 VSQX" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock l:UiText.Text="GAME 从音频识别音高、起点和终点，与音素结果合成为 VSQX。支持整首；无需人工确认即可导出。" TextWrapping="Wrap" FontSize="12" Opacity=".7"/>
        <TextBox x:Name="NoteSnapshotBox" l:UiText.Header="GAME 模型目录（本地；CPU 四线程）" l:UiText.Placeholder="配置 local-notes.json 或选择已有模型目录"/>
        <Button Click="BrowseNoteModel_Click" HorizontalAlignment="Stretch"><TextBlock l:UiText.Text="选择 GAME 模型目录" TextWrapping="Wrap"/></Button>
        <TextBlock x:Name="NoteRuntimeStatus" TextWrapping="Wrap" FontSize="12"/>
        <NumberBox x:Name="ScoreTempo" l:UiText.Header="节拍网格 BPM" l:UiText.ToolTip="保留实际秒数；导出音高由音高模式决定" Value="120" Minimum="20" Maximum="400" SmallChange="1"/>
        <ComboBox x:Name="ScorePitchMode" l:UiText.Header="导出音高模式" HorizontalAlignment="Stretch" SelectedIndex="1" SelectionChanged="ScorePitchMode_Changed">
         <ComboBoxItem Tag="original" l:UiText.Content="原始音高"/>
         <ComboBoxItem Tag="miku_v4c_octave" l:UiText.Content="Miku V4C 八度适配"/>
         <ComboBoxItem Tag="manual" l:UiText.Content="手动移调"/>
        </ComboBox>
        <NumberBox x:Name="ScoreTranspose" l:UiText.Header="手动移调（半音）" Value="0" Minimum="-36" Maximum="36" SmallChange="1" LargeChange="12" SpinButtonPlacementMode="Compact" IsEnabled="False" ValueChanged="ScoreTranspose_Changed"/>
        <Button x:Name="AnalyzeScoreButton" Click="AnalyzeScore_Click" HorizontalAlignment="Stretch"><TextBlock l:UiText.Text="生成 VSQX（GAME 音高与起止点）" TextWrapping="Wrap"/></Button>
        <Button x:Name="ImportNotesButton" Click="ImportNotes_Click" HorizontalAlignment="Stretch"><TextBlock l:UiText.Text="使用已保存 GAME 音符（不重复推理）" TextWrapping="Wrap"/></Button>
        <Button x:Name="ImportScoreButton" Click="ImportScore_Click" HorizontalAlignment="Stretch"><TextBlock l:UiText.Text="导入已有 VSQX 并生成音素草稿" TextWrapping="Wrap"/></Button>
        <Button x:Name="ExportScoreButton" Click="ExportScore_Click" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"><TextBlock l:UiText.Text="导出 VSQX（按所选音高模式）" TextWrapping="Wrap"/></Button>
       </StackPanel>
      </Border>
     </ScrollViewer>
     <Grid Grid.Column="1" Padding="12" RowSpacing="10" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock l:UiText.Text="音符预览（原始识别／导入音高，移调仅用于导出）" TextWrapping="Wrap" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock x:Name="ScoreStatus" Grid.Row="1" l:UiText.Text="尚无音符数据；TXT 仅为辅助音素导出。" TextWrapping="Wrap"/>
      <TextBlock Grid.Row="2" l:UiText.Text="起点（秒）／时值（秒）／音高 MIDI／音素来源" TextWrapping="Wrap" FontSize="12" Opacity=".7"/>
      <ListView x:Name="ScoreList" Grid.Row="3" SelectionChanged="Score_Selected" HorizontalContentAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Auto" l:UiText.AutomationName="音符列表">
       <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="Wrap" Padding="0,4"/></DataTemplate></ListView.ItemTemplate>
      </ListView>
     </Grid>
    </Grid>
   </PivotItem>

   <PivotItem l:UiText.Header="模型与设置">
    <Grid ColumnSpacing="12">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
      <Border Padding="12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
       <StackPanel Spacing="10">
        <TextBlock l:UiText.Text="模型安装" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock x:Name="ModelSetupStatus" l:UiText.Text="正在检查模型文件……" TextWrapping="Wrap"/>
        <ProgressBar x:Name="ModelDownloadProgress" Minimum="0" Maximum="100" Visibility="Collapsed" l:UiText.AutomationName="模型下载进度"/>
        <TextBox x:Name="ModelProxyBox" l:UiText.Header="下载代理（可选）" l:UiText.Placeholder="例如 http://127.0.0.1:18080；留空使用系统代理"/>
        <CheckBox x:Name="AutoDownloadBox" IsChecked="False" Checked="AutoDownload_Changed" Unchecked="AutoDownload_Changed"><TextBlock l:UiText.Text="启动时自动下载缺失模型" TextWrapping="Wrap"/></CheckBox>
        <Button x:Name="InstallModelsButton" Click="InstallModels_Click" HorizontalAlignment="Stretch"><TextBlock l:UiText.Text="下载 / 继续下载模型" TextWrapping="Wrap"/></Button>
        <Button x:Name="ImportModelsButton" Click="ImportModels_Click" HorizontalAlignment="Stretch"><TextBlock l:UiText.Text="导入离线模型文件夹" TextWrapping="Wrap"/></Button>
        <TextBlock l:UiText.Text="PhoneticXeus：Apache-2.0；GAME 权重：CC BY-NC-SA 4.0（限非商业使用）。模型文件校验成功后才启用，识别阶段断网。" TextWrapping="Wrap" FontSize="12" Opacity=".7"/>
       </StackPanel>
      </Border>
     </ScrollViewer>
     <Grid Grid.Column="1" RowSpacing="12">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <ScrollViewer MaxHeight="270" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
       <Border Padding="12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <StackPanel Spacing="8">
         <TextBlock l:UiText.Text="环境与诊断" FontSize="18" FontWeight="SemiBold"/>
         <StackPanel x:Name="EnvironmentActions" Spacing="6">
          <Button l:UiText.Content="检查环境" Click="Doctor_Click" HorizontalAlignment="Stretch"/>
          <Button l:UiText.Content="检查程序更新" Click="CheckUpdate_Click" HorizontalAlignment="Stretch" l:UiText.ToolTip="仅检查公开正式版，不会自动下载或替换程序"/>
          <Button l:UiText.Content="导出诊断包" Click="ExportDiagnostics_Click" HorizontalAlignment="Stretch" l:UiText.ToolTip="保存脱敏错误码、模型文件状态与资源信息；不会上传，可在模型未就绪时使用"/>
          <Button l:UiText.Content="释放模型显存" Click="Unload_Click" HorizontalAlignment="Stretch"/>
          <Button l:UiText.Content="显式回放 JSON" Click="Replay_Click" HorizontalAlignment="Stretch" l:UiText.ToolTip="只回放已有结果，不执行真实模型推理"/>
         </StackPanel>
         <TextBlock x:Name="GpuStatus" l:UiText.Text="GPU 状态尚未检查" TextWrapping="Wrap" FontSize="12" Opacity=".7"/>
        </StackPanel>
       </Border>
      </ScrollViewer>
      <Grid Grid.Row="1" Padding="12" RowSpacing="8" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <TextBlock l:UiText.Text="任务日志" FontSize="18" FontWeight="SemiBold"/>
       <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <TextBlock x:Name="ActivityLog" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" IsTextSelectionEnabled="True"/>
       </ScrollViewer>
      </Grid>
     </Grid>
    </Grid>
   </PivotItem>
   <PivotItem x:Name="CantoneseTab" Header="Cantonese">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
     <Border Padding="12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
      <StackPanel Spacing="10">
       <TextBlock Text="{Binding Text, ElementName=AudioPathBox}" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" Opacity=".7"/>
       <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Button x:Name="CantoneseModelButton" Content="Model folder" Click="CantoneseModel_Click"/>
        <Button x:Name="CantonesePrepareButton" Grid.Column="1" Content="Prepare" Click="CantonesePrepare_Click"/>
        <Button x:Name="CantoneseRunButton" Grid.Column="2" Content="Start" Click="CantoneseRun_Click" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"/>
        <Button x:Name="CantoneseOpenButton" Grid.Column="3" Content="Open results" Click="CantoneseOpen_Click" HorizontalAlignment="Stretch" IsEnabled="False"/>
       </Grid>
       <TextBlock x:Name="CantoneseBundlePath" Text="models/cantonese4" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" FontSize="12" Opacity=".7"/>
       <TextBlock x:Name="CantoneseStatus" TextWrapping="Wrap"/>
       <TextBox x:Name="CantoneseJyutpingBox" Header="Jyutping" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="130" MaxHeight="260" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
       <TextBox x:Name="CantoneseIpaBox" Header="IPA" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="130" MaxHeight="260" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
      </StackPanel>
     </Border>
    </ScrollViewer>
   </PivotItem>
  </Pivot>

  <ScrollViewer Grid.Row="3" MaxHeight="72" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
   <InfoBar x:Name="StatusBar" IsOpen="True" IsClosable="False" Severity="Informational" l:UiText.Title="本地模式" l:UiText.Message="真实识别、结果回放和人工修改分别标记。"/>
  </ScrollViewer>
 </Grid>
</Page>
