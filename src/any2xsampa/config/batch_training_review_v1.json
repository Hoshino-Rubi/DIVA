{
  "schema_version": "batch_training_review_policy_v1",
  "maximum_active_slots": 20,
  "existing_active_slots": 9,
  "maximum_new_slots": 11,
  "window_sec": 10,
  "step_sec": 0.5,
  "minimum_similarity": 0.45,
  "minimum_rendered_duration_sec": 7,
  "maximum_rendered_duration_sec": 13,
  "minimum_changed_correspondence_sec": 0.5,
  "maximum_alternatives": 3,
  "machine_dual_path_threshold_sec": 0.2,
  "human_proposal_scope": "audio_path_hypotheses_not_machine_acceptance",
  "selection": "fewest_selected_song_then_context_then_old_center_then_song_order_then_start",
  "same_context_section_anchors_only": true,
  "exclude_retained_and_recent_location_original_windows_from_new_proposals": true,
  "historically_rejected_windows_require_changed_pairing": true,
  "mapping_complete_required_for_new_proposed_section": true,
  "empty_edge_neighborhood": "show_first_or_last_overlapping_note_as_navigation_only_with_full_original_audio",
  "old_pending_ids": ["C05", "C10", "C13", "C16", "C20"],
  "do_not_reask": ["C03", "C11", "L01", "L02", "L03", "L04"],
  "human_confirmation_required": true,
  "training_started": false
}
